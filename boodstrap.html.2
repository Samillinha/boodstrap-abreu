    <main>
        <section id="carrosel" class="bg-info p-0">
            <div id="carouselExample" class="carousel slide">
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="1.png" class="d-block w-100" style="height: 500px; object-fit: cover;" alt="...">
                    </div>
                    <div class="carousel-item">
                        <img src="2.png" class="d-block w-100" style="height: 500px; object-fit: cover;" alt="...">
                    </div>
                    <div class="carousel-item">
                        <img src="ronaldplett-toucan-10442734_1920.jpg" class="d-block w-100" style="height: 500px; object-fit: cover;  " alt="...">
                    </div>
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample"
